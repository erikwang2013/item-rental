<view class="wrap">
  <view class="logo">闲租</view>
  <view class="sub">手机号登录,新用户自动注册</view>

  <view class="card">
    <view class="form-item">
      <text class="label">手机号</text>
      <input type="number" maxlength="11" placeholder="请输入手机号" value="{{phone}}" bindinput="onPhone" />
    </view>
  </view>

  <button class="btn btn-primary go" bindtap="login">登录</button>
</view>
