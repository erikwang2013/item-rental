.home { padding-bottom: 30rpx; }
.search-bar {
  display: flex; align-items: center; margin: 20rpx 24rpx; background: #fff;
  border-radius: 36rpx; height: 72rpx; padding: 0 28rpx;
}
.s-ico { font-size: 28rpx; margin-right: 12rpx; }
.s-ph { color: #bbb; font-size: 28rpx; }
.cats { white-space: nowrap; padding: 10rpx 12rpx 20rpx; }
.cat { display: inline-flex; flex-direction: column; align-items: center; width: 128rpx; }
.cat-ico {
  width: 88rpx; height: 88rpx; line-height: 88rpx; text-align: center; background: #e8f5e9;
  color: #2e7d32; border-radius: 50%; font-size: 36rpx;
}
.cat-name { font-size: 22rpx; color: #555; margin-top: 8rpx; max-width: 120rpx; overflow: hidden; text-overflow: ellipsis; }
.sec-title { font-size: 32rpx; font-weight: 600; margin: 20rpx 24rpx 16rpx; }
.grid { display: flex; flex-wrap: wrap; padding: 0 12rpx; }
.cell { width: 48%; margin: 0 1% 20rpx; background: #fff; border-radius: 16rpx; overflow: hidden; }
.img { width: 100%; height: 300rpx; background: #f0f0f0; }
.c-title { font-size: 26rpx; padding: 12rpx 16rpx 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.c-foot { display: flex; justify-content: space-between; align-items: center; padding: 8rpx 16rpx 16rpx; }
.c-city { font-size: 22rpx; }
