<view class="list" wx:if="{{items.length}}">
  <view class="row" wx:for="{{items}}" wx:key="id" data-id="{{item.id}}" bindtap="goDetail">
    <image class="thumb" src="{{item.cover}}" mode="aspectFill" />
    <view class="flex1 info">
      <view class="title1 t">{{item.title}}</view>
      <view class="muted">{{item.city}} · 押金 {{fmtMoney(item.deposit)}}</view>
      <view class="price">{{fmtMoney(item.daily_price)}}<text class="unit">/天</text></view>
    </view>
  </view>
</view>
<view class="empty" wx:else>该分类下暂无物品</view>
