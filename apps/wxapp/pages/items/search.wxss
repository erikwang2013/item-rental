.bar { display: flex; align-items: center; padding: 16rpx 24rpx; gap: 16rpx; background: #fff; }
.kw { flex: 1; background: #f5f5f5; border-radius: 30rpx; padding: 0 24rpx; height: 64rpx; font-size: 26rpx; }
.city-box { display: flex; align-items: center; background: #f5f5f5; border-radius: 30rpx; padding: 0 16rpx 0 20rpx; }
.city { width: 140rpx; height: 64rpx; font-size: 26rpx; }
.x { color: #999; padding: 0 4rpx; font-size: 28rpx; }
.go { color: #2e7d32; font-size: 28rpx; }
.row { display: flex; align-items: center; background: #fff; margin: 16rpx 24rpx; padding: 16rpx; border-radius: 12rpx; }
.info { margin-left: 20rpx; }
.t { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.unit { font-size: 22rpx; font-weight: 400; color: #e53935; }
