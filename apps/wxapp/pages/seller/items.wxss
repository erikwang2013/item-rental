.add { margin: 24rpx 24rpx 8rpx; }
.pval { min-height: 60rpx; line-height: 60rpx; }
.ph { color: #bbb; }
.form-item.col { flex-direction: column; align-items: stretch; }
.form-item.col .label { margin-bottom: 12rpx; }
.ta { width: 100%; min-height: 80rpx; font-size: 26rpx; }
.pics { display: flex; flex-wrap: wrap; margin-top: 8rpx; }
.pic { position: relative; width: 160rpx; height: 160rpx; margin: 0 16rpx 16rpx 0; border-radius: 12rpx; overflow: hidden; }
.pic .thumb { width: 100%; height: 100%; }
.pic.add { display: flex; align-items: center; justify-content: center; background: #f1f5f1; color: #2e7d32; font-size: 48rpx; border: 2rpx dashed #b9d4b9; box-sizing: border-box; }
.pic.add text { font-size: 40rpx; color: #2e7d32; }
.pic-del { position: absolute; top: 0; right: 0; width: 40rpx; height: 40rpx; line-height: 36rpx; text-align: center; background: rgba(0,0,0,.55); color: #fff; border-radius: 0 0 0 12rpx; font-size: 28rpx; }
.pub { margin-top: 24rpx; }
.info { margin-left: 20rpx; }
.t { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.st { display: inline-block; font-size: 22rpx; color: #999; margin-top: 6rpx; }
.st.on { color: #2e7d32; }
.off { margin-left: 16rpx; flex-shrink: 0; }
.lg { width: 300rpx; margin: 40rpx auto; }
