<view class="form card">
  <view class="form-item">
    <text class="label">昵称</text>
    <input maxlength="64" placeholder="请输入昵称" value="{{nickname}}" bindinput="onNick" />
  </view>
  <view class="form-item">
    <text class="label">真实姓名</text>
    <input maxlength="64" placeholder="选填" value="{{realName}}" bindinput="onReal" />
  </view>
  <view class="form-item">
    <text class="label">头像 URL</text>
    <input placeholder="https://… 选填,服务端暂无上传接口" value="{{avatar}}" bindinput="onAvatarUrl" />
  </view>
</view>
<view class="muted note">头像需为可访问的图片 URL</view>
<button class="btn btn-primary save" bindtap="save" disabled="{{saving}}">保存</button>
