# ===== 多端租赁平台 基础设施环境变量 =====
# 复制为 .env 后按需修改：cp .env.example .env
# 注意：这些是开发默认值，生产环境务必更换强密码

# --- MySQL ---
MYSQL_ROOT_PASSWORD=root123456
MYSQL_DATABASE=rental
MYSQL_USER=rental
MYSQL_PASSWORD=rental123456
MYSQL_PORT=3306

# --- OpenSearch ---
OPENSEARCH_PORT=9200

# --- Redis ---
REDIS_PASSWORD=redis123456
REDIS_PORT=6379
